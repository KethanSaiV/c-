#include <stdio.h>

#define BINS 256

int main() {
    int img[512][512];
    int hist[BINS] = {0};

    printf("Enter 512x512 image pixel values (0–255):\n");

    for (int i = 0; i < 512; i++)
        for (int j = 0; j < 512; j++) {
            scanf("%d", &img[i][j]);
            hist[img[i][j]]++;
        }

    printf("Intensity Histogram:\n");
    for (int i = 0; i < BINS; i++)
        printf("%d %d\n", i, hist[i]);

    return 0;
}
